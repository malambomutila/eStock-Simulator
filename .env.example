# LLM 
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Database 
DATABASE_URL=sqlite:///data/estock.db
DB_ECHO_SQL=false

# PostgreSQL (optional — uncomment and fill for production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/estock

# Simulation
SIMULATION_FACILITY_ID=FACILITY-001
REORDER_ALERT_THRESHOLD_DAYS=90
LOW_STOCK_THRESHOLD_PCT=0.20
ANOMALY_SPIKE_MULTIPLIER=3.0

# API 
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
